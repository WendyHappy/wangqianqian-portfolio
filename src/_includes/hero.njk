<section class="hero">
  <div class="hero-avatar" aria-hidden="true">
    <img src="{{ '/images/avatar.jpeg' | url }}" alt="{{ site.name }}" class="avatar-img" onerror="this.style.display='none';this.parentElement.classList.add('fallback')">
    <span class="avatar-fallback">{{ site.name | first }}</span>
  </div>
  <h1 class="hero-name">{{ site.name }}</h1>
  {% if site.name_en %}
  <p class="hero-name-en">{{ site.name_en }}</p>
  {% endif %}
  <p class="hero-tagline">{{ site.title }}</p>
  <p class="hero-desc">{{ site.description }}</p>
</section>
