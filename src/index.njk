{# === 联系我 === #}
<section class="content-panel" id="panel-contact" data-panel="contact">
  <h2 class="panel-title">联系我</h2>
  <div class="contact-card">
    <p class="contact-note">扫码添加微信，注明来意</p>
    <img src="{{ '/images/wechat-qr.jpeg' | url }}" alt="微信二维码" class="qr-code">
