---
layout: base.njk
---

{# === 基本信息（简历式） === #}
<section class="content-panel active" id="panel-about" data-panel="about">
  <div class="resume-card">
    <div class="resume-header">
      <div class="resume-avatar">
        <img src="{{ '/images/avatar.jpeg' | url }}" alt="" onerror="this.parentElement.classList.add('fallback')">
        <span class="resume-avatar-fallback">{{ site.name | first }}</span>
      </div>
      <div class="resume-title">
        <h1>{{ site.name }} <small>{{ site.name_en }}</small></h1>
        <p>{{ site.title }}</p>
      </div>
    </div>

    <div class="resume-section">
      <h3>关于我</h3>
      <p>{{ profile.bio }}</p>
    </div>
  </div>
</section>

{# === 代写 === #}
<section class="content-panel" id="panel-writing" data-panel="writing">
  <h2 class="panel-title">代写服务</h2>

  {% for svc in services %}{% if svc.id == "writing" %}
  <div class="card service-overview">
    <h3>{{ svc.title }}</h3>
    <p class="card-summary">{{ svc.summary }}</p>
    <ul class="highlight-list">
      {% for item in svc.highlights %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}{% endfor %}

  <p class="section-intro">{{ manuscripts.intro }}</p>

  <div class="stats-strip">
    {% for stat in manuscripts.stats %}
    <div class="stat-item">
      <span class="stat-value">{{ stat.value }}</span>
      <span class="stat-label">{{ stat.label }}</span>
    </div>
    {% endfor %}
  </div>

  <h3 class="sub-title">服务类别</h3>
  <div class="card-grid">
    {% for cat in manuscripts.categories %}
    <div class="card category-card">
      <span class="card-icon">{{ cat.icon }}</span>
      <h4>{{ cat.name }}</h4>
      <p class="card-summary">{{ cat.desc }}</p>
      <div class="sample-tags">
        {% for s in cat.samples %}<span class="sample-tag">{{ s }}</span>{% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>

  <h3 class="sub-title">效率工具</h3>
  <div class="card-grid">
    {% for proj in projects %}{% if "writing" in proj.tags or "academic" in proj.tags %}
    <div class="card project-card{% if proj.featured %} featured{% endif %}">
      <span class="card-category">{{ proj.category }}</span>
      <h3>{{ proj.title }}</h3>
      <p class="card-summary">{{ proj.summary }}</p>
    </div>
    {% endif %}{% endfor %}
  </div>

  <h3 class="sub-title">相关技能</h3>
  <div class="skills-grid">
    {% for group in skills %}{% if "writing" in group.tags or "academic" in group.tags %}
    <div class="skill-group">
      <h4>{{ group.category }}</h4>
      <ul class="skill-list">
        {% for item in group.items %}
        <li class="skill-item">
          <span class="skill-name">{{ item.name }}</span>
          <span class="skill-level">{{ item.level }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}{% endfor %}
  </div>
</section>

{# === 公众号 === #}
